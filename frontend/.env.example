# Copy to frontend/.env, then fill in your Clerk publishable key.
# For Google and email sign-in, enable both methods in the Clerk dashboard.

# Publishable key from https://dashboard.clerk.com/api-keys
# Leave empty until Clerk is configured; the landing page will still run.
VITE_CLERK_PUBLISHABLE_KEY=

# URL of the optional Go API. The landing page and waiting list do not need it.
VITE_API_URL=http://localhost:8080
