# Copy this file to .env in the repository root.
# Local development and both Docker Compose files read this one file.

# Public Clerk key from https://dashboard.clerk.com/api-keys
# This VITE_ value is included in the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=

# Leave empty to call /api on the same origin in both dev and production.
VITE_API_URL=

# SQLite file path, relative to the repository root.
DATABASE_PATH=./data/semuabisaai.db

# Server-only key for the five-question OpenRouter feature. Never prefix with VITE_.
OPENROUTER_API_KEY=

# Go API address.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Clerk secret key for the optional Go backend. Never prefix it with VITE_.
CLERK_SECRET_KEY=

# For a public domain, use its hostname and bind to all interfaces.
# TAILSCALE_IP keeps the private HTTP address available alongside the domain.
# For Tailscale-only deployment, use DOMAIN_NAME=http://<tailscale-ip>
# and BIND_ADDRESS=<tailscale-ip>.
DOMAIN_NAME=
BIND_ADDRESS=
TAILSCALE_IP=
