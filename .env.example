# Copy to .env if you run the optional Go backend.
# The landing page and Clerk sign-in use frontend/.env instead.

# SQLite file path, relative to the repository root.
DATABASE_PATH=./data/semuabisaai.db

# Go API address.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Clerk secret key from https://dashboard.clerk.com/api-keys
# Server-side only. Never put this key in frontend/.env or a VITE_ variable.
CLERK_SECRET_KEY=
