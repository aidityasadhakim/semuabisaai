# Copy this file to .env in the repository root.
# Local development and both Docker Compose files read this one file.

# Public Clerk key from https://dashboard.clerk.com/api-keys
# This VITE_ value is included in the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=

# Leave empty to call /api on the same origin in both dev and production.
VITE_API_URL=

# SQLite file path, relative to the repository root.
DATABASE_PATH=./data/semuabisaai.db

# Go API address.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Clerk secret key for the optional Go backend. Never prefix it with VITE_.
CLERK_SECRET_KEY=

# Required when deploying with docker-compose.prod.yml.
DOMAIN_NAME=
SSL_EMAIL=
